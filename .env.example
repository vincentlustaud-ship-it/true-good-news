# Copier en .env pour le développement local (jamais commité).
# Sur Netlify : Site settings → Environment variables.

# Qualification éditoriale (obligatoire : sans clé, rien n'est proposé à la validation)
ANTHROPIC_API_KEY=
# Modèle utilisé pour la qualification (optionnel)
QUALIFY_MODEL=claude-opus-5

# Traduction FR/EN (optionnelle : sans clé, contenu en langue d'origine + lien de traduction externe)
DEEPL_API_KEY=

# Google Fact Check Tools (optionnelle : sans clé, aucune candidate ne dépasse « Bien corroboré »)
GOOGLE_FACTCHECK_API_KEY=

# Envoi de l'email quotidien (optionnelle : sans clé, la publication a lieu, l'envoi est retenté)
RESEND_API_KEY=
EMAIL_FROM="True Good News <bonjour@truegoodnewstoday.com>"

# Espace de validation : hash bcrypt du mot de passe (npm run hash-password -- 'mot de passe')
ADMIN_PASSWORD_HASH=
# Signature du cookie de session admin et des appels internes (32+ caractères aléatoires)
SESSION_SECRET=

# Base des liens (confirmation, désabonnement, email)
SITE_URL=https://truegoodnewstoday.com
# Adresse de contact affichée sur le site
CONTACT_EMAIL=contact@truegoodnewstoday.com

# Bluesky (optionnel, repérage uniquement). La recherche de posts n'est plus ouverte sans
# authentification : sans ces valeurs, Bluesky est ignoré. Mot de passe d'application (gratuit),
# à créer dans Settings > App Passwords ; jamais le mot de passe du compte.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# Reddit (optionnel, repérage uniquement : sans identifiants, Reddit est ignoré)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
